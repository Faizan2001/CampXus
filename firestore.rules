rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles (/users) ---
    // Users can read their own profile completely.
    // They can also read the public profiles of other users (for friend discovery).
    // Phase-1: Schedule data is stored within user documents as 'scheduleData' field.
    match /users/{userId} {
      // Allow reading other users' profiles for friend discovery, but schedule data is handled separately
      allow read: if request.auth != null && (
        // Case 1: The user is requesting their own document.
        request.auth.uid == userId ||
        // Case 2: The user is requesting a public schedule.
        resource.data.scheduleData.privacy.visibility == 'public' ||
        // Case 3: The user is a friend and the schedule is friends-only.
        (resource.data.scheduleData.privacy.visibility == 'friends' && areFriends(request.auth.uid, userId))
      );
      
      // A user can create their own profile document, but cannot create one for someone else.
      allow create: if request.auth.uid == userId;
      
      // A user can only update or delete their own profile and schedule data.
      allow update, delete: if request.auth.uid == userId;
    }
    
    // --- Helper Functions ---
    // Function to check if user can read another user's public profile (but not schedule data)
    function isPublicProfileRead(requestUserId, targetUserId) {
      // For Phase-1: Allow reading profile fields for friend discovery
      // Schedule data access will be restricted in Phase-2+ when friends viewing is implemented
      return requestUserId != targetUserId; // Can read others' profiles for friend discovery
    }

    function areFriends(userId1, userId2) {
      // Check if a friendship document exists where the 'users' array contains both user IDs.
      return exists(/databases/$(database)/documents/friendships/$(friendshipId)) &&
             friendshipId in get(/databases/$(database)/documents/friendships/$(friendshipId)).data.users &&
             userId1 in get(/databases/$(database)/documents/friendships/$(friendshipId)).data.users &&
             userId2 in get(/databases/$(database)/documents/friendships/$(friendshipId)).data.users;
    }

    // --- Universities (Read-Only) ---
    // Any authenticated user can read the list of universities.
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }

    // --- Friend Requests (/friendRequests) ---
    // Users can read requests sent TO them.
    // Users can create new requests.
    // Users can update/delete requests they sent OR received.
    match /friendRequests/{requestId} {
      allow read, update, delete: if request.auth != null && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // --- Friendships (/friendships) ---
    // Users can read/update/delete friendships they are a part of.
    // Users can create friendships.
    match /friendships/{friendshipId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null;
    }
  }
}