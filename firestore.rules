rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles (/users) ---
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource.data.socialInfo.searchable == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.universityInfo.university == resource.data.universityInfo.university) ||
        canViewFriendSchedule(request.auth.uid, userId)
      );
      allow create: if request.auth.uid == userId;
      allow update, delete: if request.auth.uid == userId;
    }
    
    // --- Friendships (/friendships) ---
    match /friendships/{friendshipId} {
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && request.auth.uid in resource.data.users && validateBilateralPrivacyUpdate(request, resource);
    }

    // --- Friend Requests (/friendRequests) ---
    match /friendRequests/{requestId} {
      allow read, update, delete: if request.auth != null && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // --- Universities (Read-Only) ---
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- GDPR & Consent Collections ---
    match /user_consents/{consentId} {
        allow create, update: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth.uid == resource.data.userId;
        allow delete: if false;
    }

    match /user_deletion_requests/{requestId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        allow read, update, delete: if false;
    }

    // --- Helper Functions ---
    function areFriends(userId1, userId2) {
      return exists(/databases/$(database)/documents/friendships/$(userId1 < userId2 ? userId1 + '_' + userId2 : userId2 + '_' + userId1));
    }

    function canViewFriendSchedule(viewerUserId, scheduleOwnerUserId) {
      // Note: Firestore rules do not support 'let' variables.
      // The friendshipId is constructed directly in the path.
      return exists(/databases/$(database)/documents/friendships/$(viewerUserId < scheduleOwnerUserId ? viewerUserId + '_' + scheduleOwnerUserId : scheduleOwnerUserId + '_' + viewerUserId)) &&
             get(/databases/$(database)/documents/friendships/$(viewerUserId < scheduleOwnerUserId ? viewerUserId + '_' + scheduleOwnerUserId : scheduleOwnerUserId + '_' + viewerUserId)).data.scheduleVisibility[scheduleOwnerUserId] == true;
    }

    function validateBilateralPrivacyUpdate(request, resource) {
      // Optimized validation for atomic field-level updates
      return (
        // Condition 1: The user must be part of this friendship
        request.auth.uid in resource.data.users &&
        
        // Condition 2: Core friendship data must remain unchanged (if present in update)
        (!('users' in request.resource.data) || request.resource.data.users == resource.data.users) &&
        (!('user1Id' in request.resource.data) || request.resource.data.user1Id == resource.data.user1Id) &&
        (!('user2Id' in request.resource.data) || request.resource.data.user2Id == resource.data.user2Id) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
        
        // Condition 3: If privacyMetadata is being updated, user must be correctly attributed
        (!('privacyMetadata' in request.resource.data) ||
         request.resource.data.privacyMetadata.privacyUpdatedBy == request.auth.uid) &&
        
        // Condition 4: User can only update their own schedule visibility
        // Check if scheduleVisibility field is being modified
        (!('scheduleVisibility' in request.resource.data) ||
         (
           // User can only modify their own visibility setting
           request.resource.data.scheduleVisibility.keys().hasAll([request.auth.uid]) ||
           // Or if updating the full object, it must contain both users and only change their own setting
           (request.resource.data.scheduleVisibility.keys().hasAll(resource.data.users) &&
            resource.data.users.hasAll(request.resource.data.scheduleVisibility.keys()))
         ))
      );
    }
  }
}