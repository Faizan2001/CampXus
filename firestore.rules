rules_version = '3';
service cloud.firestore {
  match /databases/{database}/documents {
    // Security baseline - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Simplified user rules for development and organized structure
    match /users/{userId} {
      // Allow read if user is authenticated and accessing their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow write if user is authenticated and accessing their own document
      // Simplified validation for development
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
    }

    // Universities collection - read only for authenticated users
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only (handled in Cloud Functions)
    }
  }
}