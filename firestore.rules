rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Security baseline - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User document rules - allow users to manage their own documents
    match /users/{userId} {
      // Allow read if user is authenticated and accessing their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow write if user is authenticated and accessing their own document
      // Simplified rule for better compatibility
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Universities collection - read only for authenticated users
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only (handled in Cloud Functions)
    }
  }
}