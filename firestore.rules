rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles (/users) ---
    // Users can read their own profile completely.
    // They can also read the public profiles of other users.
    match /users/{userId} {
      allow read: if request.auth != null; // Allow any authenticated user to read profiles (for searching)
      // A user can create their own profile document, but cannot create one for someone else.
      allow create: if request.auth.uid == userId;
      // A user can only update or delete their own profile.
      allow update, delete: if request.auth.uid == userId;
    }

    // --- Universities (Read-Only) ---
    // Any authenticated user can read the list of universities.
    match /universities/{universityId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }

    // --- Friend Requests (/friendRequests) ---
    // Users can read requests sent TO them.
    // Users can create new requests.
    // Users can update/delete requests they sent OR received.
    match /friendRequests/{requestId} {
      allow read, update, delete: if request.auth != null && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create: if request.auth != null;
    }

    // --- Friendships (/friendships) ---
    // Users can read/delete friendships they are a part of.
    // Users can create friendships.
    match /friendships/{friendshipId} {
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null;
    }
  }
}