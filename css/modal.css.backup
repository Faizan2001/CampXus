/* css/modal.css - Enhanced with consistent styling from main app */

/* Import CSS Custom Properties from main styles */
/* Variables are defined in styles.css and will be inherited */

/* ================================
   BASE CUSTOM MODAL STYLES (Apply to all modals)
================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(8px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-medium),
    visibility var(--transition-medium);
  overflow-y: auto;
  padding: var(--spacing-lg);
  box-sizing: border-box;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  padding: var(--spacing-xl);
  border-radius: var(--border-radius-large);
  box-shadow: var(--shadow-heavy);
  width: 90%;
  max-width: 450px;
  text-align: center;
  transform: scale(0.85) translateY(20px);
  transition: transform var(--transition-medium);
  display: flex;
  flex-direction: column;
  max-height: 85vh;
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
  overflow: hidden;
}

.modal-content::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--primary-gradient);
  border-radius: var(--border-radius-large) var(--border-radius-large) 0 0;
}

.modal-overlay.active .modal-content {
  transform: scale(1) translateY(0);
}

.modal-title {
  font-size: clamp(1.3rem, 3vw, 1.8rem);
  font-weight: 700;
  margin: 0 0 var(--spacing-lg);
  background: var(--gradient-title);
  background-size: 300% 300%;
  animation: waveGradient 10s ease infinite;
  background-clip: text;
  color: transparent;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  flex-shrink: 0;
  position: relative;
}

.modal-title::after {
  content: "";
  display: block;
  width: 40px;
  margin: var(--spacing-sm) auto 0;
  height: 2px;
  border-radius: 1px;
  background: var(--gradient-accent);
  animation: pulseGlow 2s ease-in-out infinite alternate;
}

.modal-message {
  font-size: clamp(0.85rem, 2vw, 0.95rem);
  color: var(--text-primary);
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-y: auto;
  flex-grow: 1;
  word-wrap: break-word;
  padding: 0 var(--spacing-xs);
  margin-bottom: var(
    --spacing-lg
  ); /* MODIFICATION: Added spacing below message, above buttons */
}

.modal-action-buttons {
  display: flex;
  justify-content: space-evenly;
  margin-top: auto;
  padding-top: var(--spacing-lg);
  gap: var(--spacing-md);
  flex-shrink: 0;
}

.modal-button {
  padding: var(--spacing-md) var(--spacing-xl);
  border: 2px solid transparent;
  border-radius: var(--border-radius);
  font-weight: 600;
  font-size: clamp(0.8rem, 2vw, 0.9rem);
  cursor: pointer;
  transition: all var(--transition-medium);
  min-width: 100px;
  position: relative;
  overflow: hidden;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  backdrop-filter: blur(5px);
}

.modal-button::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent
  );
  transition: left 0.5s ease;
}

.modal-button:hover::before {
  left: 100%;
}

.modal-button:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-medium);
}

.modal-button:active {
  transform: translateY(-1px);
  box-shadow: var(--shadow-light);
}

.modal-close-btn {
  background: var(--primary-gradient);
  color: white;
  border-color: rgba(74, 0, 224, 0.3);
}

.modal-close-btn:hover {
  background: linear-gradient(135deg, #5a10f0, #9e3de2);
  border-color: rgba(74, 0, 224, 0.5);
}

.modal-button.confirm {
  background: linear-gradient(135deg, #2ed573, #1dd1a1);
  color: white;
  border-color: rgba(46, 213, 115, 0.3);
}

.modal-button.confirm:hover {
  background: linear-gradient(135deg, #1dd1a1, #00d2d3);
  border-color: rgba(46, 213, 115, 0.5);
}

.modal-button.cancel {
  background: linear-gradient(135deg, #ff4757, #ff3742);
  color: white;
  border-color: rgba(255, 71, 87, 0.3);
}

.modal-button.cancel:hover {
  background: linear-gradient(135deg, #ff3742, #ff2731);
  border-color: rgba(255, 71, 87, 0.5);
}

.modal-input.input-error,
.time-input-field.input-error {
  border-color: var(--color-error) !important;
  background-color: rgba(255, 71, 87, 0.1);
  box-shadow: 0 0 0 3px rgba(255, 71, 87, 0.1) !important;
}

/* ================================
   FORM ELEMENTS IN MODALS
================================== */
.modal-input {
  padding: var(--spacing-md);
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius);
  outline: none;
  transition: all var(--transition-fast);
  font-family: inherit;
  font-size: clamp(0.85rem, 2vw, 0.95rem);
  width: 100%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(5px);
  color: var(--text-primary);
}

.modal-input:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(74, 0, 224, 0.1);
  background: white;
}

.modal-input:focus-visible {
  outline: 2px solid var(--primary-color);
  outline-offset: 2px;
}

/* ===========================================================
   STYLES FOR "EDIT TIME SLOT" MODAL (using .modal-form-container)
=========================================================== */
.modal-message .modal-form-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  text-align: left;
  gap: var(--spacing-md);
}

#edit-slot-start-time-wrapper,
#edit-slot-end-time-wrapper {
  line-height: 1.2;
}

.modal-message .modal-form-container > h3 {
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  font-weight: 700;
  margin: 0;
  text-align: center;
  flex-shrink: 0;
  color: var(--text-primary);
  background: linear-gradient(120deg, #4a00e0, #8e2de2);
  background-clip: text;
  color: transparent;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.modal-message .modal-form-container > p {
  font-size: clamp(0.8rem, 2vw, 0.9rem);
  margin: 0;
  flex-shrink: 0;
  color: var(--text-secondary);
  line-height: 1.5;
}

.modal-message .modal-form-container > p.time-input-hint {
  font-size: clamp(0.75rem, 1.8vw, 0.85rem);
  color: var(--text-secondary);
  margin: 0;
  text-align: left;
  line-height: 1.4;
  flex-shrink: 0;
  padding: var(--spacing-sm);
  background: rgba(74, 0, 224, 0.05);
  border-radius: var(--border-radius);
  border-left: 3px solid #4a00e0;
}

.modal-message .modal-form-container .form-group {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
}

.modal-message .modal-form-container .form-group label {
  display: block;
  margin-bottom: var(--spacing-xs);
  font-weight: 600;
  font-size: clamp(0.8rem, 2vw, 0.9rem);
  color: var(--text-primary);
  line-height: 1.3;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.modal-message .modal-form-container .modal-input {
  display: block;
  width: 100%;
  margin: 0;
}

.modal-message .modal-form-container .modal-error-message {
  color: #fff;
  background: linear-gradient(135deg, #ff4757, #ff3742);
  border: 2px solid rgba(255, 71, 87, 0.3);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) 0;
  border-radius: var(--border-radius);
  font-size: clamp(0.8rem, 1.8vw, 0.9rem);
  text-align: left;
  flex-shrink: 0;
  box-shadow: var(--shadow-light);
  backdrop-filter: blur(10px);
}

/* ===========================================================
   STYLES FOR "ADD NEW TIME SLOT" MODAL (using .add-timeslot-form-content)
=========================================================== */
.modal-message .add-timeslot-form-content {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: var(--spacing-lg);
  text-align: left;
}

.modal-message
  .add-timeslot-form-content
  > div:not(.modal-error-message):not(p.time-input-hint) {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm);
  background: rgba(248, 249, 250, 0.5);
  border-radius: var(--border-radius);
  border: 1px solid var(--border-color);
  transition: all var(--transition-fast);
}

.modal-message
  .add-timeslot-form-content
  > div:not(.modal-error-message):not(p.time-input-hint):hover {
  background: rgba(248, 249, 250, 0.8);
  border-color: var(--primary-color);
  box-shadow: var(--shadow-light);
}

.modal-message .add-timeslot-form-content label {
  font-weight: 600;
  font-size: clamp(0.85rem, 2vw, 0.95rem);
  color: var(--text-primary);
  flex-shrink: 0;
  width: 80px;
  text-align: right;
  padding-right: var(--spacing-xs);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.modal-message .add-timeslot-form-content .modal-input {
  max-width: 160px;
  width: 100%;
  margin: 0;
}

.modal-message .add-timeslot-form-content p.time-input-hint {
  font-size: clamp(0.75rem, 1.8vw, 0.85rem);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.4;
  margin: 0;
  padding: var(--spacing-md);
  background: rgba(74, 0, 224, 0.05);
  border-radius: var(--border-radius);
  border: 1px solid rgba(74, 0, 224, 0.1);
}

.modal-message .add-timeslot-form-content .modal-error-message {
  color: #fff;
  background: linear-gradient(135deg, #ff4757, #ff3742);
  border: 2px solid rgba(255, 71, 87, 0.3);
  padding: var(--spacing-md);
  border-radius: var(--border-radius);
  font-size: clamp(0.8rem, 1.8vw, 0.9rem);
  text-align: left;
  box-shadow: var(--shadow-light);
  backdrop-filter: blur(10px);
  margin: 0;
}

/* ================================
   RESPONSIVE BREAKPOINTS FOR MODALS
================================== */

/* Small mobile devices */
@media (max-width: 480px) {
  .modal-overlay {
    padding: var(--spacing-md);
  }

  .modal-content {
    padding: var(--spacing-lg);
    max-width: 95%;
    border-radius: var(--border-radius);
  }

  .modal-action-buttons {
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .modal-button {
    width: 100%;
    min-width: auto;
  }

  .modal-message
    .add-timeslot-form-content
    > div:not(.modal-error-message):not(p.time-input-hint) {
    flex-direction: column;
    align-items: stretch;
    gap: var(--spacing-sm);
  }

  .modal-message .add-timeslot-form-content label {
    width: auto;
    text-align: left;
    padding-right: 0;
  }

  .modal-message .add-timeslot-form-content .modal-input {
    max-width: 100%;
  }
}

/* Medium mobile devices */
@media (min-width: 481px) and (max-width: 768px) {
  .modal-content {
    padding: var(--spacing-xl);
    max-width: 420px;
  }
}

/* Tablet and desktop */
@media (min-width: 769px) {
  .modal-content {
    max-width: 480px;
  }
}

/* Landscape orientation adjustments */
@media (orientation: landscape) and (max-height: 600px) {
  .modal-overlay {
    padding: var(--spacing-sm);
  }

  .modal-content {
    padding: var(--spacing-lg);
    max-height: 90vh;
  }

  .modal-title {
    font-size: clamp(1.2rem, 2.5vh, 1.5rem);
  }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
  .modal-content {
    background: rgba(33, 37, 41, 0.98);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-input {
    background: rgba(73, 80, 87, 0.9);
    border-color: var(--border-color);
    color: var(--text-primary);
  }

  .modal-message .modal-form-container > p.time-input-hint,
  .modal-message .add-timeslot-form-content p.time-input-hint {
    background: rgba(74, 0, 224, 0.1);
    border-color: rgba(74, 0, 224, 0.2);
  }

  .modal-message
    .add-timeslot-form-content
    > div:not(.modal-error-message):not(p.time-input-hint) {
    background: rgba(73, 80, 87, 0.5);
    border-color: var(--border-color);
  }

  .modal-message
    .add-timeslot-form-content
    > div:not(.modal-error-message):not(p.time-input-hint):hover {
    background: rgba(73, 80, 87, 0.8);
    border-color: var(--primary-color);
  }
}

/* Reduced motion preference */
@media (prefers-reduced-motion: reduce) {
  .modal-overlay,
  .modal-content,
  .modal-button,
  .modal-input {
    transition-duration: 0.01ms !important;
  }

  .modal-title {
    animation: none !important;
  }

  .modal-title::after {
    animation: none !important;
  }

  .modal-button::before {
    transition: none !important;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .modal-content {
    border: 3px solid currentColor;
  }

  .modal-button {
    border: 2px solid currentColor;
  }

  .modal-input {
    border: 2px solid currentColor;
  }

  /* MODIFICATION: Enhanced high contrast for modal title */
  .modal-title {
    background: none !important; /* Remove gradient for high contrast */
    background-clip: initial !important; /* Reset background clip */
    -webkit-background-clip: initial !important; /* Reset for WebKit */
    color: currentColor !important; /* Ensure text uses a high contrast color */
    -webkit-text-fill-color: currentColor !important; /* Ensure WebKit text fill is high contrast */
    text-shadow: none !important; /* Remove any text shadows */
  }

  .modal-title::after {
    background: currentColor !important; /* Make underline use high contrast color */
    animation: none !important; /* Also disable animation for underline in high contrast */
  }
}

/* ================================
   KEYFRAME ANIMATIONS (Reused from main styles)
================================== */
@keyframes pulseGlow {
  from {
    box-shadow: 0 0 5px rgba(255, 182, 255, 0.5);
  }
  to {
    box-shadow: 0 0 20px rgba(255, 182, 255, 0.8);
  }
}

@keyframes waveGradient {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* ================================
   ACCESSIBILITY IMPROVEMENTS
================================== */
.modal-button:focus-visible,
.modal-input:focus-visible {
  outline: 2px solid var(--primary-color);
  outline-offset: 2px;
}

/* Ensure modal content is accessible */
.modal-overlay[aria-hidden="false"] {
  display: flex;
}

.modal-overlay[aria-hidden="true"] {
  display: none;
}
