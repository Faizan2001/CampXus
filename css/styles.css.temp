/* ===== CSS RESET & BASE STYLES ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ===== CSS CUSTOM PROPERTIES ===== */
:root {
  /* Light theme colors */
  --bg-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --bg-secondary: rgba(255, 255, 255, 0.1);
  --glass-bg: rgba(255, 255, 255, 0.15);
  --glass-border: rgba(255, 255, 255, 0.2);
  --text-primary: #2d3748;
  --text-secondary: #4a5568;
  --text-light: #718096;
  --accent-primary: #667eea;
  --accent-secondary: #764ba2;
  --surface: rgba(255, 255, 255, 0.9);
  --surface-hover: rgba(255, 255, 255, 0.95);
  --border: rgba(0, 0, 0, 0.1);
  --shadow: rgba(0, 0, 0, 0.1);
  --success: #48bb78;
  --warning: #ed8936;
  --error: #f56565;
  --nav-bg: rgba(255, 255, 255, 0.95);

  /* Gradient for animated title */
  --gradient-title: linear-gradient(120deg, #d57cff, #ff769f, #a1c4fd, #c2e9fb);
  --gradient-accent: linear-gradient(to right, #d57cff, #ff769f);
}

/* Dark theme colors */
.dark-mode {
  --bg-primary: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  --bg-secondary: rgba(0, 0, 0, 0.2);
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-border: rgba(255, 255, 255, 0.1);
  --text-primary: #e2e8f0;
  --text-secondary: #cbd5e0;
  --text-light: #a0aec0;
  --accent-primary: #4299e1;
  --accent-secondary: #9f7aea;
  --surface: rgba(255, 255, 255, 0.05);
  --surface-hover: rgba(255, 255, 255, 0.1);
  --border: rgba(255, 255, 255, 0.1);
  --shadow: rgba(0, 0, 0, 0.3);
  --success: #68d391;
  --warning: #fbb86f;
  --error: #fc8181;
  --nav-bg: rgba(0, 0, 0, 0.3);

  /* Gradient for animated title */
  --gradient-title: linear-gradient(120deg, #d57cff, #ff769f, #a1c4fd, #c2e9fb);
  --gradient-accent: linear-gradient(to right, #d57cff, #ff769f);
}

/* ===== BASE STYLES ===== */
html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    sans-serif;
  font-weight: 400;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-primary);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Background effects */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(
      circle at 20% 20%,
      rgba(120, 119, 198, 0.3) 0%,
      transparent 50%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(255, 119, 198, 0.3) 0%,
      transparent 50%
    ),
    radial-gradient(
      circle at 40% 60%,
      rgba(120, 219, 226, 0.3) 0%,
      transparent 50%
    );
  pointer-events: none;
  z-index: -1;
}

/* ===== LAYOUT CONTAINER ===== */
.app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== TOP NAVIGATION ===== */
.top-nav {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  background: var(--nav-bg);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 4px 20px var(--shadow);
}

.nav-left,
.nav-center,
.nav-right {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--accent-primary);
}

.logo span {
  background: var(--gradient-title);
  background-size: 300% 300%;
  animation: waveGradient 10s ease infinite;
  background-clip: text;
  color: transparent;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 900;
  font-style: italic;
  display: inline-block;
  transition: transform 0.3s ease;
  position: relative;
}

.logo span:hover {
  transform: scale(1.02);
}

.logo span::after {
  content: "";
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 2px;
  background: var(--gradient-title);
  background-size: 300% 300%;
  animation: waveGradient 10s ease infinite;
  border-radius: 2px;
  opacity: 0.8;
}

/* Hide the calendar icon for cleaner modern look */
.logo i {
  display: none;
  font-size: 1.5rem;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  text-decoration: none;
  color: var(--text-secondary);
  font-weight: 500;
  transition: all 0.3s ease;
  background: transparent;
}

.nav-link:hover {
  background: var(--surface-hover);
  color: var(--accent-primary);
  transform: translateY(-2px);
}

.nav-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border: none;
  border-radius: 50%;
  background: var(--surface);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 1rem;
}

.nav-button:hover {
  background: var(--surface-hover);
  color: var(--accent-primary);
  transform: scale(1.1);
}

/* ===== MAIN CONTENT ===== */
.main-content {
  flex: 1;
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

.content-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 2rem;
  height: 100%;
}

/* ===== GLASS CARD COMPONENT ===== */
.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 1.5rem;
  padding: 2rem;
  box-shadow: 0 8px 32px var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent
  );
}

.glass-card::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    from 0deg at 50% 50%,
    transparent 0deg,
    rgba(255, 255, 255, 0.03) 60deg,
    transparent 120deg,
    rgba(255, 255, 255, 0.03) 180deg,
    transparent 240deg,
    rgba(255, 255, 255, 0.03) 300deg,
    transparent 360deg
  );
  animation: rotate 20s linear infinite;
  pointer-events: none;
  z-index: -1;
}

@keyframes rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.glass-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.glass-card h3 {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-primary);
}

.glass-card h3 i {
  color: var(--accent-primary);
  font-size: 1.1rem;
}

.glass-card h4 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 1rem;
}

/* ===== CONTROLS COLUMN ===== */
.controls-column {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* ===== BUTTON STYLES ===== */
.primary-btn,
.secondary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 1.5rem;
  border: none;
  border-radius: 0.75rem;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.primary-btn {
  background: linear-gradient(
    135deg,
    var(--accent-primary),
    var(--accent-secondary)
  );
  color: white;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
}

.secondary-btn {
  background: var(--surface);
  color: var(--text-primary);
  border: 1px solid var(--border);
}

.secondary-btn:hover {
  background: var(--surface-hover);
  transform: translateY(-2px);
}

.primary-btn:disabled,
.secondary-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.full-width {
  width: 100%;
}

.button-group {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* ===== INPUT STYLES ===== */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-wrapper i {
  position: absolute;
  left: 1rem;
  color: var(--text-light);
  z-index: 1;
}

.input-wrapper input,
.input-wrapper textarea {
  width: 100%;
  padding: 1rem 1rem 1rem 2.5rem;
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  background: var(--surface);
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.input-wrapper textarea {
  resize: vertical;
  min-height: 3rem;
  font-family: inherit;
}

.input-wrapper input:focus,
.input-wrapper textarea:focus {
  outline: none;
  border-color: var(--accent-primary);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  background: var(--surface-hover);
}

.input-wrapper input::placeholder,
.input-wrapper textarea::placeholder {
  color: var(--text-light);
}

/* ===== USERS LIST ===== */
.user-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.user-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  transition: all 0.3s ease;
}

.user-item:hover {
  background: var(--surface-hover);
  transform: translateX(5px);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.user-name {
  font-weight: 600;
  color: var(--text-primary);
}

.user-id {
  font-size: 0.85rem;
  color: var(--text-light);
}

.user-actions {
  display: flex;
  gap: 0.5rem;
}

.user-actions button {
  padding: 0.5rem;
  border: none;
  border-radius: 0.5rem;
  background: var(--surface);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.3s ease;
}

.user-actions button:hover {
  background: var(--accent-primary);
  color: white;
}

/* ===== USER LIST INTERACTION STATES ===== */
.user-item.active {
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
  color: white;
  border-color: var(--accent-primary);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  transform: translateX(5px) scale(1.02);
}

.user-item.selected {
  background: linear-gradient(135deg, var(--success), #38a169);
  color: white;
  border-color: var(--success);
  box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
  transform: translateX(5px) scale(1.02);
}

.user-item.active .user-name-btn,
.user-item.selected .user-name-btn {
  color: white;
}

.user-name-btn {
  background: none;
  border: none;
  color: var(--text-primary);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  padding: 0;
  text-align: left;
  flex-grow: 1;
  transition: all 0.3s ease;
}

.delete-btn {
  background: var(--error);
  color: white;
  border: none;
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.delete-btn:hover {
  background: #e53e3e;
  transform: scale(1.05);
  box-shadow: 0 4px 15px rgba(245, 101, 101, 0.4);
}

/* ===== SCHEDULE SECTION ===== */
.schedule-section {
  height: fit-content;
}

.schedule-wrapper {
  overflow-x: auto;
  border-radius: 1rem;
}

.schedule-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 4px 20px var(--shadow);
}

.schedule-table th,
.schedule-table td {
  padding: 1rem 0.75rem;
  text-align: center;
  border-bottom: 1px solid var(--border);
  transition: all 0.3s ease;
}

.schedule-table th {
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  font-weight: 600;
  color: var(--text-primary);
  position: sticky;
  top: 0;
  z-index: 10;
}

.day-label {
  font-weight: 600;
  color: var(--text-primary);
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  position: sticky;
  left: 0;
  z-index: 5;
}

.slot {
  background: var(--surface);
  cursor: pointer;
  position: relative;
  min-height: 3rem;
  border: 1px solid transparent;
}

.slot:hover {
  background: var(--surface-hover);
  border-color: var(--accent-primary);
}

.slot.selected {
  background: linear-gradient(
    135deg,
    var(--accent-primary),
    var(--accent-secondary)
  );
  color: white;
}

.slot.unavailable {
  background: var(--error);
  color: white;
}

.slot.available {
  background: var(--success);
  color: white;
}

.add-timeslot-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: none;
  border-radius: 50%;
  background: var(--accent-primary);
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  margin: 0 auto;
}

.add-timeslot-btn:hover {
  background: var(--accent-secondary);
  transform: scale(1.1);
}

/* ===== TOOLTIP ===== */
.slot-tooltip {
  position: absolute;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: 0.5rem;
  padding: 0.75rem;
  font-size: 0.85rem;
  color: var(--text-primary);
  z-index: 1000;
  pointer-events: none;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  max-width: 200px;
  word-wrap: break-word;
}

/* ===== RIPPLE EFFECT ===== */
.ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  animation: ripple-animation 0.6s ease-out;
  pointer-events: none;
}

@keyframes ripple-animation {
  0% {
    transform: scale(0);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

/* ===== ENHANCED GLASSMORPHISM EFFECTS ===== */
.glass-card::after {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    from 0deg at 50% 50%,
    transparent 0deg,
    rgba(255, 255, 255, 0.03) 60deg,
    transparent 120deg,
    rgba(255, 255, 255, 0.03) 180deg,
    transparent 240deg,
    rgba(255, 255, 255, 0.03) 300deg,
    transparent 360deg
  );
  animation: rotate 20s linear infinite;
  pointer-events: none;
  z-index: -1;
}

@keyframes rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* ===== ENHANCED BUTTON STATES ===== */
.primary-btn::after,
.secondary-btn::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  transition: left 0.5s ease;
}

.primary-btn:hover::after,
.secondary-btn:hover::after {
  left: 100%;
}

/* ===== LOADING STATES ===== */
.loading {
  position: relative;
  overflow: hidden;
}

.loading::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent
  );
  animation: loading-shimmer 2s infinite;
}

@keyframes loading-shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* ===== RESPONSIVE DESIGN ===== */
@media (max-width: 1024px) {
  .content-grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .schedule-column {
    order: -1;
  }
}

@media (max-width: 768px) {
  .top-nav {
    padding: 1rem;
  }

  .nav-center {
    display: none;
  }

  .main-content {
    padding: 1rem;
  }

  .glass-card {
    padding: 1.5rem;
  }

  .button-group {
    flex-direction: column;
  }

  .schedule-table th,
  .schedule-table td {
    padding: 0.75rem 0.5rem;
    font-size: 0.85rem;
  }
}

@media (max-width: 480px) {
  .top-nav {
    padding: 0.75rem;
  }

  .logo span {
    display: none;
  }

  .main-content {
    padding: 0.75rem;
  }

  .glass-card {
    padding: 1rem;
    border-radius: 1rem;
  }

  .schedule-table th,
  .schedule-table td {
    padding: 0.5rem 0.25rem;
    font-size: 0.8rem;
  }
}

/* ===== ANIMATIONS ===== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.glass-card {
  animation: fadeIn 0.6s ease forwards;
}

.glass-card:nth-child(1) {
  animation-delay: 0.1s;
}
.glass-card:nth-child(2) {
  animation-delay: 0.2s;
}
.glass-card:nth-child(3) {
  animation-delay: 0.3s;
}
.glass-card:nth-child(4) {
  animation-delay: 0.4s;
}
.glass-card:nth-child(5) {
  animation-delay: 0.5s;
}

/* ===== SCROLLBAR STYLING ===== */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--surface);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb {
  background: var(--accent-primary);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-secondary);
}

/* ===== ACCESSIBILITY ===== */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Focus indicators */
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}

/* ===== KEYFRAME ANIMATIONS ===== */
@keyframes waveGradient {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes pulseGlow {
  from {
    box-shadow: 0 0 5px rgba(255, 182, 255, 0.5);
  }
  to {
    box-shadow: 0 0 20px rgba(255, 182, 255, 0.8);
  }
}

/* About Page Specific Styles */
.about-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  display: grid;
  gap: 2rem;
  grid-template-columns: 1fr;
}

.developer-profile {
  grid-column: 1;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.profile-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    var(--accent-primary),
    var(--accent-secondary)
  );
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: white;
  flex-shrink: 0;
}

.profile-info h2 {
  margin: 0 0 0.5rem 0;
  font-size: 2rem;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-title {
  margin: 0;
  color: var(--text-secondary);
  font-size: 1.1rem;
  font-weight: 500;
}

.profile-content {
  display: grid;
  gap: 2rem;
}

.bio-section h3,
.skills-section h3,
.features-section h3,
.contact-section h3 {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0 0 1rem 0;
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--text-primary);
}

.bio-section h3 i,
.skills-section h3 i,
.features-section h3 i,
.contact-section h3 i {
  color: var(--accent-primary);
}

.bio-section p {
  margin: 0 0 1rem 0;
  line-height: 1.6;
  color: var(--text-secondary);
}

.tech-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1rem;
}

.tech-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.tech-item:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--accent-primary);
}

.tech-item i {
  font-size: 2rem;
  color: var(--accent-primary);
}

.tech-item span {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--text-primary);
}

.features-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 0.8rem;
}

.features-list li {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.8rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  transition: all 0.3s ease;
}

.features-list li:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.1);
}

.features-list li i {
  color: #10b981;
  font-size: 1.1rem;
}

.contact-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.contact-buttons .btn {
  flex: 1;
  min-width: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.project-info,
.acknowledgments {
  margin-top: 1rem;
}

.project-info h3,
.acknowledgments h3 {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0 0 1.5rem 0;
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--text-primary);
}

.project-info h3 i,
.acknowledgments h3 i {
  color: var(--accent-primary);
}

.info-grid {
  display: grid;
  gap: 1rem;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.info-label {
  font-weight: 500;
  color: var(--text-secondary);
}

.info-value {
  font-weight: 600;
  color: var(--text-primary);
}

.ack-content p {
  margin: 0 0 1rem 0;
  color: var(--text-secondary);
  line-height: 1.6;
}

.ack-content ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.ack-content li {
  padding: 0.8rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  line-height: 1.5;
}

.ack-content li:last-child {
  border-bottom: none;
}

.ack-content strong {
  color: var(--text-primary);
  font-weight: 600;
}

/* Responsive Design for About Page */
@media (min-width: 768px) {
  .about-container {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
  }

  .developer-profile {
    grid-column: 1;
    grid-row: 1 / -1;
  }

  .project-info {
    grid-column: 2;
    grid-row: 1;
    margin-top: 0;
  }

  .acknowledgments {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0;
  }

  .contact-buttons .btn {
    flex: none;
    min-width: 140px;
  }
}

@media (max-width: 480px) {
  .about-container {
    padding: 1rem;
  }

  .profile-header {
    flex-direction: column;
    text-align: center;
    gap: 1rem;
  }

  .profile-avatar {
    width: 60px;
    height: 60px;
    font-size: 1.5rem;
  }

  .profile-info h2 {
    font-size: 1.5rem;
  }

  .tech-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .contact-buttons {
    flex-direction: column;
  }

  .contact-buttons .btn {
    flex: none;
    width: 100%;
  }
}

/* ===== USER LIST INTERACTION STATES ===== */
.user-item.active {
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
  color: white;
  border-color: var(--accent-primary);
  box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
  transform: translateX(5px) scale(1.02);
}

.user-item.selected {
  background: linear-gradient(135deg, var(--success), #38a169);
  color: white;
  border-color: var(--success);
  box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
  transform: translateX(5px) scale(1.02);
}

.user-item.active .user-name-btn,
.user-item.selected .user-name-btn {
  color: white;
}

.user-name-btn {
  background: none;
  border: none;
  color: var(--text-primary);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  padding: 0;
  text-align: left;
  flex-grow: 1;
  transition: all 0.3s ease;
}

.delete-btn {
  background: var(--error);
  color: white;
  border: none;
  border-radius: 0.5rem;
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.delete-btn:hover {
  background: #e53e3e;
  transform: scale(1.05);
  box-shadow: 0 4px 15px rgba(245, 101, 101, 0.4);
}

/* ===== SCHEDULE SLOT STATE CLASSES ===== */
.slot-selected {
  background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
  color: white;
  border-color: var(--accent-primary);
  box-shadow: inset 0 0 20px rgba(102, 126, 234, 0.3);
}

.slot-free {
  background: linear-gradient(135deg, var(--success), #38a169);
  color: white;
  border-color: var(--success);
  box-shadow: inset 0 0 20px rgba(72, 187, 120, 0.2);
}

.slot-conflict {
  background: linear-gradient(135deg, var(--error), #e53e3e);
  color: white;
  border-color: var(--error);
  box-shadow: inset 0 0 20px rgba(245, 101, 101, 0.3);
}

.slot-partial {
  background: linear-gradient(135deg, var(--warning), #dd6b20);
  color: white;
  border-color: var(--warning);
  box-shadow: inset 0 0 20px rgba(237, 137, 54, 0.2);
}

/* Override hover states for slot states */
.slot-selected:hover,
.slot-free:hover,
.slot-conflict:hover,
.slot-partial:hover {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
}

/* ===== BUTTON STATE CLASSES FOR CONTROLS ===== */
.primary-btn.active,
.secondary-btn.active {
  background: linear-gradient(135deg, var(--success), #38a169);
  color: white;
  border-color: var(--success);
  box-shadow: 0 8px 25px rgba(72, 187, 120, 0.4);
}

.primary-btn:disabled,
.secondary-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  background: var(--surface);
  color: var(--text-light);
  border-color: var(--border);
}

/* ===== PIN INDICATORS ===== */
.pin-indicator,
.can-pin-indicator {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 10;
}

.pin-indicator {
  background: var(--warning);
  color: white;
  box-shadow: 0 2px 8px rgba(237, 137, 54, 0.4);
}

.can-pin-indicator {
  background: var(--success);
  color: white;
  box-shadow: 0 2px 8px rgba(72, 187, 120, 0.4);
}

.pin-indicator:hover,
.can-pin-indicator:hover {
  transform: scale(1.1);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
}

/* ===== USERS LIST ===== */
.user-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.user-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  transition: all 0.3s ease;
}

.user-item:hover {
  background: var(--surface-hover);
  transform: translateX(5px);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.user-name {
  font-weight: 600;
  color: var(--text-primary);
}

.user-id {
  font-size: 0.85rem;
  color: var(--text-light);
}

.user-actions {
  display: flex;
  gap: 0.5rem;
}

.user-actions button {
  padding: 0.5rem;
  border: none;
  border-radius: 0.5rem;
  background: var(--surface);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.3s ease;
}

.user-actions button:hover {
  background: var(--accent-primary);
  color: white;
}
