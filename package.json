{
  "name": "campxus",
  "version": "1.0.0",
  "description": "A web-based scheduling and availability tracker for university students to: - Add their own class schedule - See overlaps with other students - Compare availability in real-time - Navigate easily between Schedule, Friends, and About sections.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "dev": "npm run dev:config && vite --host",
    "build": "node scripts/generate-sitemap.js && vite build",
    "preview": "vite preview",
    "dev:config": "node src/js/core/firestore/dev-tools/generate-env-config.js",
    "dev:check": "node src/js/core/firestore/dev-tools/check-dev-setup.js",
    "dev:serve": "npm run dev:config && firebase serve",
    "firebase:serve": "firebase serve",
    "firebase:deploy": "firebase deploy",
    "firebase:emulators": "firebase emulators:start",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npx audit-ci",
    "seo:sitemap": "node scripts/generate-sitemap.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faizan2001/CampXus.git"
  },
  "keywords": [],
  "author": "Faizan2001",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Faizan2001/CampXus/issues"
  },
  "homepage": "https://github.com/Faizan2001/CampXus#readme",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "audit-ci": "^6.6.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/src/js/tests/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(firebase|@firebase)/)"
    ],
    "moduleNameMapper": {
      "^firebase/(.*)$": "<rootDir>/node_modules/firebase/$1",
      "^/src/css/styles\\.css$": "identity-obj-proxy",
      "^/src/.*\\.(css|scss|sass)$": "identity-obj-proxy",
      "^.+\\.(css|scss|sass)$": "identity-obj-proxy",
      "^.*/spa-init\\.js$": "<rootDir>/src/js/tests/__mocks__/spa-init.mock.js",
      "^.*/app\\.js$": "<rootDir>/src/js/tests/__mocks__/spa-init.mock.js"
    },
    "testTimeout": 10000,
    "maxWorkers": 1,
    "forceExit": true
  },
  "dependencies": {
    "firebase": "^11.8.1",
    "playwright": "^1.54.1",
    "tesseract.js": "^6.0.1"
  }
}
